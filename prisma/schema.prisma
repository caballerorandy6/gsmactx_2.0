generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                   String        @id @default(uuid())
  email                String        @unique
  password             String
  name                 String
  passwordResetToken   String?       @unique
  passwordResetExpires DateTime?
  appointments         Appointment[]
  campaigns            Campaign[]
  smsCampaigns         SMSCampaign[]
}

model Appointment {
  id            String            @id @default(uuid())
  clientName    String
  clientEmail   String
  clientPhone   String
  serviceType   ServiceType
  scheduledDate DateTime
  scheduledTime String
  address       String
  notes         String?
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     String?
  admin         Admin?            @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([scheduledDate])
  @@index([status])
}

model Campaign {
  id               String             @id @default(uuid())
  title            String
  subject          String
  content          String
  createdAt        DateTime           @default(now())
  sent             Boolean            @default(false)
  sentAt           DateTime?
  createdBy        String
  imageUrl         String?
  templateType     String?            @default("promotional")
  failedCount      Int?
  sentCount        Int?
  totalEmails      Int?
  admin            Admin              @relation(fields: [createdBy], references: [id])
  emailLogs        CampaignEmailLog[]

  @@index([createdBy])
  @@index([sent])
}

model CampaignEmailLog {
  id           String     @id @default(uuid())
  campaignId   String
  subscriberId String
  status       String     @default("pending")
  error        String?
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([subscriberId])
}

model SMSCampaign {
  id         String       @id @default(uuid())
  title      String
  content    String
  createdAt  DateTime     @default(now())
  sent       Boolean      @default(false)
  sentAt     DateTime?
  createdBy  String
  admin      Admin        @relation(fields: [createdBy], references: [id])
  messages   SMSMessage[]

  @@index([createdBy])
  @@index([sent])
}

model SMSMessage {
  id            String      @id @default(uuid())
  smsCampaignId String
  phoneNumber   String
  status        String      @default("pending")
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  smsCampaign   SMSCampaign @relation(fields: [smsCampaignId], references: [id])

  @@index([smsCampaignId, status])
}

model Subscriber {
  id               String             @id @default(uuid())
  email            String?            @unique
  isSubscribed     Boolean            @default(true)
  createdAt        DateTime           @default(now())
  unsubscribeToken String?            @unique
  name             String?
  phone            String?
  address          String?
  emailLogs        CampaignEmailLog[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  AC_MAINTENANCE
  HEATING_MAINTENANCE
  AC_REPAIR
  HEATING_REPAIR
  AC_INSTALLATION
  HEATING_INSTALLATION
  FULL_HVAC_INSTALLATION
  DUCT_CLEANING
  FREE_ESTIMATE
}
