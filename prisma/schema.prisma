generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums for Appointments
enum ServiceType {
  AC_MAINTENANCE
  HEATING_MAINTENANCE
  AC_REPAIR
  HEATING_REPAIR
  AC_INSTALLATION
  HEATING_INSTALLATION
  FULL_HVAC_INSTALLATION
  DUCT_CLEANING
  FREE_ESTIMATE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Admin {
  id       String  @id @default(uuid())
  email    String  @unique
  password String  // Hash de contraseña
  name     String

  campaigns    Campaign[]
  smsCampaigns SMSCampaign[]
  appointments Appointment[]
}

model Appointment {
  id            String            @id @default(uuid())
  clientName    String
  clientEmail   String
  clientPhone   String
  serviceType   ServiceType
  scheduledDate DateTime
  scheduledTime String
  address       String
  notes         String?
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     String?
  admin         Admin?            @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([scheduledDate])
  @@index([createdBy])
}

model Campaign {
  id           String    @id @default(uuid())
  title        String
  subject      String
  content      String    // HTML o texto plano
  imageUrl     String?
  templateType String?   @default("promotional") // promotional, newsletter, service-reminder, seasonal
  createdAt    DateTime  @default(now())
  sent         Boolean   @default(false)
  sentAt       DateTime?

  // Campaign completion stats (saved when campaign completes)
  totalEmails  Int?      // Total emails in campaign
  sentCount    Int?      // Successfully sent emails
  failedCount  Int?      // Failed emails

  createdBy    String
  admin        Admin     @relation(fields: [createdBy], references: [id])

  emailLogs    CampaignEmailLog[]
}

model Subscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  isSubscribed     Boolean  @default(true)
  createdAt        DateTime @default(now())
  unsubscribeToken String?  @unique

  emailLogs        CampaignEmailLog[]
}

model SMSCampaign {
  id        String    @id @default(uuid())
  title     String
  content   String    // Texto del mensaje
  createdAt DateTime  @default(now())
  sent      Boolean   @default(false)
  sentAt    DateTime?
  createdBy String
  admin     Admin     @relation(fields: [createdBy], references: [id])

  messages  SMSMessage[]
}

model SMSMessage {
  id           String       @id @default(uuid())
  smsCampaignId String
  phoneNumber  String
  status       String       @default("pending")
  sentAt       DateTime?
  createdAt    DateTime     @default(now())
  campaign     SMSCampaign @relation(fields: [smsCampaignId], references: [id])
}

model CampaignEmailLog {
  id           String      @id @default(uuid())
  campaignId   String
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  subscriberId String
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  status       String      @default("pending") // pending, sent, failed, bounced
  error        String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([campaignId, status])
  @@index([subscriberId])
}
